    "field-inline": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "button-inline": {
      "$value": {
        "value": 13,
        "unit": "px"
      }
    },
    "toolbar-inline": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "order-inline": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "panel": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "page": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "header-inline": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "wide-page": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "badge": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "icon": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "menu": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "modal": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontSize": {
          "value": 13,
          "unit": "px"
        }
      }
    },
    "numeric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 13,
          "unit": "px"
        }
      }
    },
    "wordmark": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Syne",
        "fontSize": {
          "value": 22,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -1,
          "unit": "px"
        }
      }
    },
    "panel-heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 700
      }
    },
    "market-price": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 23,
          "unit": "px"
        },
        "letterSpacing": {
          "value": -0.7,
          "unit": "px"
        }
      }
    },
    "input": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 14,
          "unit": "px"
        }
      }
    }
