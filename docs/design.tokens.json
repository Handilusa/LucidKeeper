{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Source-backed inventory of the current trading-terminal worktree, not a deployment or completed QA claim.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.439,
          0.831,
          0.875
        ],
        "hex": "#70d4df"
      }
    },
    "secondary": {
      "$value": {
