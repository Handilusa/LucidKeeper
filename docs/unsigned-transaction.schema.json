{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lucidkeeper unsigned offline signing handoff",
  "description": "Format only. Requires user review, released holds, decoded allowlist checks and on-chain validation before signing/broadcasting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["chainId", "from", "to", "value", "data", "nonce", "gas", "type", "fees", "description"],
  "properties": {
    "chainId": { "const": 50383 },
    "from": { "const": "0x1420cF8Bb9D92C3fDb674ECc5A57295c59078fDA" },
    "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value": { "const": "0" },
    "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}([0-9a-fA-F]{2})*$" },
    "nonce": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "gas": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "type": { "const": "eip1559" },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFeePerGas", "maxPriorityFeePerGas"],
      "properties": {
        "maxFeePerGas": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "maxPriorityFeePerGas": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      }
    },
    "description": { "type": "string", "minLength": 1 }
  }
}
