{
  "name": "lucidkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified dreamDEX perps connectivity and execution evidence on Somnia Tokyo testnet",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ui-server.mjs",
    "ui": "node scripts/ui-server.mjs",
    "check": "node scripts/connectivity.mjs",
    "margin:prepare": "node scripts/prepare-margin.mjs",
    "order:prepare": "node scripts/prepare-order.mjs",
    "order:verify": "node scripts/verify-order.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:types": "tsc --noEmit -p test/tsconfig.e2e.json",
    "test:load": "node scripts/load-static.mjs",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage test/math.test.mjs test/dreamdex-unit.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@number-flow/react": "^0.5.14",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@somnia-chain/markets-sdk": "0.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "lenis": "1.3.27",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^1.62.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "viem": "2.57.11",
    "vite": "^6.4.5",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "ws": "^8.22.0",
    "decode-uri-component": "^0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
